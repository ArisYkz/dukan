# .npmrc - NPM Configuration for Faster Installation
# Skip optional dependencies and suppress audit warnings

# Skip lifecycle scripts during install to prevent Supabase CLI binary download
# which causes ECONNRESET errors (ECONNRESET). Platform-specific binaries for
# rollup, swc, etc. are installed via optionalDependencies as normal.
ignore-scripts=true

# Speed up installation
fund=false
audit=false

# Use exact versions for deterministic builds
save-exact=true
